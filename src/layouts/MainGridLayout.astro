---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import Navbar from "@components/Navbar.astro";
import TOC from "@components/widget/TOC.astro";
import type { MarkdownHeading } from "astro";
import { siteConfig } from "../config";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const { title, banner, description, lang, setOGTypeArticle, headings = [] } = Astro.props;
---
<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>
    <slot slot="head" name="head" />
    <header id="navbar-wrapper" class="site-header"><Navbar /></header>
    <div class:list={["journal-layout", { "journal-layout--reading": !!title }]}>
        <main id="main-content" tabindex="-1">
            <div id="content-wrapper"><slot /></div>
        </main>
        {siteConfig.toc.enable && headings.length > 0 && <aside class="journal-toc" aria-label="文章目录">
            <p class="section-label">本页目录</p>
            <div id="toc-inner-wrapper"><div id="toc"><TOC headings={headings} /></div></div>
        </aside>}
    </div>
    <div class="journal-footer"><Footer /></div>
    <BackToTop />
</Layout>
