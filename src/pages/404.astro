---
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";
---

<MainGridLayout title="页面未找到" description="这个页面不存在，或尚未迁移到新站。">
    <section class="card-base px-6 py-10 md:px-9">
        <p class="text-sm font-bold text-[var(--primary)]">404</p>
        <h1 class="mt-2 mb-4 text-3xl font-bold text-90">页面未找到</h1>
        <p class="text-75">这个页面不存在，或尚未迁移到新站。可以返回首页，或从文章归档继续浏览。</p>
        <div class="mt-6 flex flex-wrap gap-3">
            <a class="btn-regular rounded-lg px-4 py-2" href={url("/")}>返回首页</a>
            <a class="btn-regular rounded-lg px-4 py-2" href={url("/archive/")}>文章归档</a>
        </div>
    </section>
</MainGridLayout>
