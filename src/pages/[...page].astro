---
import { type CollectionEntry, getCollection } from "astro:content";
import type { GetStaticPaths, Page } from "astro";
import LegacyArticle from "../components/LegacyArticle.astro";
import Pagination from "../components/control/Pagination.astro";
import PostPage from "../components/PostPage.astro";
import { PAGE_SIZE } from "../constants/constants";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { getSortedPosts } from "../utils/content-utils";
import { siteConfig } from "../config";

interface Props {
	page?: Page<CollectionEntry<"posts">>;
	entry?: CollectionEntry<"posts"> | CollectionEntry<"legacy-pages">;
}

export const getStaticPaths = (async ({ paginate }) => {
	const allBlogPosts = await getSortedPosts();
	const legacyPages = await getCollection("legacy-pages");
	const paths = [
		...paginate(allBlogPosts, { pageSize: PAGE_SIZE }),
		...[...allBlogPosts, ...legacyPages].map((entry) => ({
			params: {
				page: decodeURI(entry.data.originalPath || entry.id).replace(/^\/+|\/+$/g, ""),
			},
			props: { entry },
		})),
	];
	const seen = new Set(["archive", "rss.xml", "robots.txt"]);
	for (const path of paths) {
		const key = path.params.page || "";
		if (seen.has(key)) {
			throw new Error(`Duplicate public route: /${key}/`);
		}
		seen.add(key);
	}
	return paths;
}) satisfies GetStaticPaths;

const { page, entry } = Astro.props;

const len = page?.data.length ?? 0;
---

{entry ? <LegacyArticle entry={entry} /> : page && <MainGridLayout>
    <h1 class="sr-only">{siteConfig.title}</h1>
    <PostPage page={page}></PostPage>
    <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${(len)*50}ms)`}></Pagination>
</MainGridLayout>}
